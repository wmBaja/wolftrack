{
  "name": "wolftrack",
  "version": "1.1.2",
  "private": true,
  "engines": {
    "node": ">=22.12.0"
  },
  "workspaces": [
    "apps/dashboard"
  ],
  "scripts": {
    "dev": "npm run dev --workspace @wolftrack/dashboard",
    "build": "npm run build --workspace @wolftrack/dashboard",
    "type-check": "npm run type-check --workspace @wolftrack/dashboard",
    "test:unit": "npm run test:unit --workspace @wolftrack/dashboard",
    "test:e2e": "npm run test:e2e --workspace @wolftrack/dashboard",
    "lint": "npm run lint --workspace @wolftrack/dashboard",
    "format": "npm run format --workspace @wolftrack/dashboard",
    "electron:build": "npm run electron:build --workspace @wolftrack/dashboard"
  },
  "allowScripts": {
    "electron-winstaller@5.4.0": true,
    "esbuild@0.28.2": true
  },
  "overrides": {
    "minimatch@>=7 <11": "11.0.9"
  }
}
